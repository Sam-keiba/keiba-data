#!/bin/sh
# いつもの更新（update → entries → baba → bloodline --new → publish）を流す。
# keiba フォルダ直下にシンボリックリンクを置けば、そこから ./refresh で流せる（README参照）。
# 例: ./refresh / ./refresh --no-upload
# 実行中はMacをスリープさせない（スリープすると取得が止まり、20分の更新に2日かかった）。
here="$(dirname "$(readlink -f "$0")")"
exec caffeinate -i uv run --project "$here" keiba-data refresh "$@"
